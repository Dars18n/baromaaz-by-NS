# Public site URL (used for canonical tags, sitemap and Open Graph links)
NEXT_PUBLIC_SITE_URL=https://www.baromaaz.com

# Razorpay (https://dashboard.razorpay.com/app/keys). Leave empty to run checkout in demo mode.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay → Account & Settings → Webhooks → secret you set (events: payment.captured, order.paid)
RAZORPAY_WEBHOOK_SECRET=

# New-order email alerts via Resend (https://resend.com — free tier). Comma-separate several emails.
RESEND_API_KEY=
ORDER_ALERT_EMAIL=
# Optional: a sender on your own verified domain, e.g. "Baromaaz Orders <orders@baromaaz.com>"
ORDER_ALERT_FROM=

# Optional: a webhook (Zapier/Make/Google Apps Script/Mailchimp) that receives newsletter signups as JSON
NEWSLETTER_WEBHOOK_URL=

# Supabase (Project Settings → API). The service_role key is SECRET — only ever in .env.local, never commit it.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Only for testing ──
# CHECKOUT_DEMO=1          → lets checkout "place" test orders without Razorpay (never on the live site)
# ALLOW_SAMPLE_CATALOG=1   → lets the site build with sample products when Supabase isn't set up
